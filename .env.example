# ----------------------------------------------------------------------------
# EduTrack environment
# Copy to `.env` and fill in. Never commit `.env`.
# Every variable here is validated at boot by src/lib/env.ts — a missing or
# malformed value fails fast at startup rather than at 9am on a Monday.
# ----------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Local development (SQLite, zero infrastructure):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also change `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/edutrack?sslmode=require"

# Session -------------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS="720"

# Application ---------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Notifications -------------------------------------------------------------
# Which channel the outbox dispatches on. CONSOLE is the safe default: it logs
# instead of sending, so no real parent is messaged from a dev machine.
NOTIFICATION_CHANNEL="CONSOLE"

# WEBHOOK channel
# NOTIFICATION_WEBHOOK_URL="https://example.com/hooks/edutrack"

# WHATSAPP channel (Meta WhatsApp Cloud API)
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE_NAME="edutrack_progress_update"

# Shared secret for the scheduled dispatch endpoint (/api/cron/notifications).
CRON_SECRET="replace-me-with-another-long-random-string"
