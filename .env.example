# ----------------------------------------------------------------------------
# EduTrack environment
# Copy to `.env` and fill in. Never commit `.env`.
# Every variable here is validated at boot by src/lib/env.ts — a missing or
# malformed value fails fast at startup rather than at 9am on a Monday.
# ----------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Local development (SQLite, zero infrastructure):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also change `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/edutrack?sslmode=require"

# Session -------------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS="720"

# Application ---------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Notifications -------------------------------------------------------------
# Which channel the outbox dispatches on. CONSOLE is the safe default: it logs
# instead of sending, so no real parent is messaged from a dev machine.
NOTIFICATION_CHANNEL="CONSOLE"

# WEBHOOK channel
# NOTIFICATION_WEBHOOK_URL="https://example.com/hooks/edutrack"

# WHATSAPP channel (Meta WhatsApp Cloud API)
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE_NAME="edutrack_progress_update"

# Shared secret for the scheduled dispatch endpoint (/api/cron/notifications).
CRON_SECRET="replace-me-with-another-long-random-string"

# Google Sign-In (optional) -------------------------------------------------
# Leave unset and the Google button is simply not rendered; passwords still
# work. There is NO client secret: the app verifies Google's ID token against
# Google's public keys, so nothing secret is stored here.
#
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your app's origin
# to "Authorized JavaScript origins" — e.g. http://localhost:3000 for local use
# and https://your-domain.in in production. Google refuses the request from any
# origin not listed.
# GOOGLE_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"

# Email (password reset) ----------------------------------------------------
# CONSOLE prints emails to the server log, including the reset link, so the
# whole flow works locally with no provider account. Switch to RESEND for real
# delivery.
EMAIL_CHANNEL="CONSOLE"
# EMAIL_CHANNEL="RESEND"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="EduTrack <no-reply@your-domain.in>"
